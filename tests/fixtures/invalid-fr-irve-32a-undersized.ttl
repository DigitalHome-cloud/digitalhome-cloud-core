@prefix dhc: <https://digitalhome.cloud/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <http://example.org/> .

# 32 A single-phase IRVE circuit on 1.5 mm²; NF C 15-100 requires ≥ 10 mm².
# Must fail nfc15100:IRVE32AMonoShape.
#
# The absence of exactly this fixture is why IRVE32AMonoShape sat permanently
# dead: its guard read `sh:hasValue 32` (xsd:integer) against a property that
# is always xsd:decimal, so the guard never matched and the shape could never
# fire. Nothing failed, because nothing ever asked it to.
ex:fr-irve-undersized a dhc:Circuit ;
  dhc:hasCircuitType dhc:CircuitType_IRVE ;
  dhc:governedBy     dhc:Norm_NFC15100 ;
  dhc:maxPoints      "1"^^xsd:integer ;
  dhc:ratedCurrent   "32"^^xsd:decimal ;
  dhc:crossSection   "1.5"^^xsd:decimal ;
  dhc:phase          "1"^^xsd:integer ;
  dhc:dedicated      true ;
  dhc:hasProtection  ex:fr-irve-undersized-rcd .

ex:fr-irve-undersized-rcd a dhc:RCBO ;
  dhc:sensitivityMA "30"^^xsd:decimal ;
  dhc:rcdType       "A" ;
  dhc:ratedCurrent  "32"^^xsd:decimal .

@prefix dhc: <https://digitalhome.cloud/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <http://example.org/> .

# IRVE (EV charging) circuit protected by a Type AC RCD. Type AC cannot detect
# the pulsating DC an on-board charger injects; NF C 15-100 requires Type A
# (or B). Correctly sized in every other respect — 32 A on 10 mm² — so this
# fixture isolates the RCD-type rule. Must fail TypeARCDShape.
ex:fr-irve-bad-rcd a dhc:Circuit ;
  dhc:hasCircuitType dhc:CircuitType_IRVE ;
  dhc:governedBy     dhc:Norm_NFC15100 ;
  dhc:maxPoints      "1"^^xsd:integer ;
  dhc:ratedCurrent   "32"^^xsd:decimal ;
  dhc:crossSection   "10.0"^^xsd:decimal ;
  dhc:phase          "1"^^xsd:integer ;
  dhc:dedicated      true ;
  dhc:hasProtection  ex:fr-irve-ac-rcd .

ex:fr-irve-ac-rcd a dhc:RCD ;
  dhc:sensitivityMA "30"^^xsd:decimal ;
  dhc:rcdType       "AC" .

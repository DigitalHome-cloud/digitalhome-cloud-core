@prefix dhc: <https://digitalhome.cloud/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <http://example.org/> .

# Lighting circuit protected by a 30 mA Type AC RCD. Type AC is fine here —
# only IRVE / induction loads demand Type A.
ex:fr-rcd-ok-circuit a dhc:Circuit ;
  dhc:hasCircuitType dhc:CircuitType_Lighting ;
  dhc:governedBy     dhc:Norm_NFC15100 ;
  dhc:maxPoints      "6"^^xsd:integer ;
  dhc:ratedCurrent   "10"^^xsd:decimal ;
  dhc:crossSection   "1.5"^^xsd:decimal ;
  dhc:hasProtection  ex:fr-rcd-ok-mcb, ex:fr-rcd-ok-rcd .

ex:fr-rcd-ok-mcb a dhc:ProtectionDevice ;
  dhc:ratedCurrent "10"^^xsd:decimal .

ex:fr-rcd-ok-rcd a dhc:RCD ;
  dhc:sensitivityMA "30"^^xsd:decimal ;
  dhc:rcdType       "AC" .

@prefix dhc: <https://digitalhome.cloud/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <http://example.org/> .

# 32 A single-phase IRVE circuit, correctly wired in 10 mm² with a Type A RCD.
ex:fr-irve-ok a dhc:Circuit ;
  dhc:hasCircuitType dhc:CircuitType_IRVE ;
  dhc:governedBy     dhc:Norm_NFC15100 ;
  dhc:maxPoints      "1"^^xsd:integer ;
  dhc:ratedCurrent   "32"^^xsd:decimal ;
  dhc:crossSection   "10.0"^^xsd:decimal ;
  dhc:phase          "1"^^xsd:integer ;
  dhc:dedicated      true ;
  dhc:hasProtection  ex:fr-irve-ok-rcd .

ex:fr-irve-ok-rcd a dhc:RCBO ;
  dhc:sensitivityMA "30"^^xsd:decimal ;
  dhc:rcdType       "A" ;
  dhc:ratedCurrent  "32"^^xsd:decimal .

# What a norm edition's template graph may say (templates.ttl). Closed: a
# property not listed here is refused. Checked on every save
# (amplify/functions/templates-shared/validate.ts), TOGETHER WITH the
# edition's own effective norm shapes, so a template must be well-formed AND
# meet its edition.
#
# Datatypes follow the dhc: T-Box ranges exactly (ratedCurrent is
# xsd:decimal, phase xsd:integer …): the norm shapes' guards compare RDF
# terms, so a "32"^^xsd:integer current would slip past them.

@prefix dht:   <https://digitalhome.cloud/templates#> .
@prefix dhtsh: <https://digitalhome.cloud/shapes/templates#> .
@prefix dhc:   <https://digitalhome.cloud/ontology#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

dhtsh:BoardTemplateShape a sh:NodeShape ;
    sh:targetClass dht:BoardTemplate ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property
        [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype rdf:langString ; sh:uniqueLang true ; sh:maxLength 200 ;
          sh:message "a template has a label, one per language, up to 200 characters" ] ,
        [ sh:path rdfs:comment ; sh:datatype rdf:langString ; sh:uniqueLang true ; sh:maxLength 2000 ;
          sh:message "a comment is text up to 2000 characters, one per language" ] ,
        [ sh:path dht:forEdition ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
          sh:pattern "^https://digitalhome\\.cloud/ontology#NormEdition_" ;
          sh:message "a template is for one norm edition (dhc:NormEdition_…)" ] ,
        [ sh:path dht:dwelling ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "T1" "T2" "T3" "T4" "T5" "T6" ) ;
          sh:message "dwelling: T1, T2, T3, T4, T5 or T6" ] ,
        [ sh:path dht:electricHeating ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
          sh:message "electric heating: true or false" ] ,
        [ sh:path dht:rows ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
          sh:minInclusive 1 ; sh:maxInclusive 8 ; sh:message "a board has 1 to 8 rows" ] ,
        [ sh:path dht:modulesPerRow ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
          sh:minInclusive 4 ; sh:maxInclusive 40 ; sh:message "a row has 4 to 40 modules" ] ,
        [ sh:path dht:hasRCD ; sh:minCount 1 ; sh:maxCount 12 ; sh:class dhc:RCD ;
          sh:message "a template has 1 to 12 RCDs" ] ,
        [ sh:path dht:hasCircuit ; sh:minCount 1 ; sh:maxCount 80 ; sh:class dhc:Circuit ;
          sh:message "a template has 1 to 80 circuits" ] ,
        [ sh:path dht:position ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:message "one position, an integer" ] ,
        [ sh:path dht:verified ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
          sh:message "verified: true or false" ] ,
        [ sh:path dht:checkedBy ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 254 ;
          sh:message "checked by: one e-mail address" ] ,
        [ sh:path dht:checkedAt ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
          sh:message "checked at: one date and time" ] .

dhtsh:TemplateRCDShape a sh:NodeShape ;
    sh:targetClass dhc:RCD ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property
        [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype rdf:langString ; sh:uniqueLang true ; sh:maxLength 120 ;
          sh:message "an RCD has a label, one per language" ] ,
        [ sh:path dhc:ratedCurrent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
          sh:minInclusive 16 ; sh:maxInclusive 125 ; sh:message "an RCD has one rating, 16 to 125 A (a decimal)" ] ,
        [ sh:path dhc:sensitivityMA ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
          sh:message "an RCD has one sensitivity in mA (a decimal)" ] ,
        [ sh:path dhc:rcdType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "AC" "A" "F" "B" ) ;
          sh:message "an RCD's type is AC, A, F or B" ] ,
        [ sh:path dht:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
          sh:message "an RCD has one position" ] .

dhtsh:TemplateCircuitShape a sh:NodeShape ;
    sh:targetClass dhc:Circuit ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property
        [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype rdf:langString ; sh:uniqueLang true ; sh:maxLength 120 ;
          sh:message "a circuit has a label, one per language" ] ,
        [ sh:path dhc:hasCircuitType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dhc:CircuitType ;
          sh:message "a circuit has one circuit type (dhc:CircuitType_…)" ] ,
        [ sh:path dhc:ratedCurrent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
          sh:minInclusive 2 ; sh:maxInclusive 63 ; sh:message "a circuit has one breaker rating, 2 to 63 A (a decimal)" ] ,
        [ sh:path dhc:crossSection ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
          sh:minInclusive 0.75 ; sh:maxInclusive 35 ; sh:message "a circuit has one wire cross-section in mm² (a decimal)" ] ,
        [ sh:path dhc:maxPoints ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ;
          sh:message "at most one number of points, ≥ 1" ] ,
        [ sh:path dhc:phase ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:in ( 1 3 ) ;
          sh:message "a circuit is single-phase (1) or three-phase (3)" ] ,
        [ sh:path dhc:dedicated ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
          sh:message "dedicated: true or false" ] ,
        [ sh:path dhc:powerRating ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ;
          sh:message "at most one power rating in W (a decimal)" ] ,
        [ sh:path dhc:hasProtection ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dhc:RCD ;
          sh:message "a circuit sits behind one RCD of its template" ] ,
        [ sh:path dhc:governedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
          sh:message "a circuit is governed by its edition's norm" ] ,
        [ sh:path dht:appliance ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 120 ;
          sh:message "at most one appliance, up to 120 characters" ] ,
        [ sh:path dht:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
          sh:message "a circuit has one position" ] .

            sh:object tag:Valve ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Equipment,
        tag:Fluid,
        tag:Liquid,
        tag:Makeup,
        tag:Valve,
        tag:Water .


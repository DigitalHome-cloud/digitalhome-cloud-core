            sh:object tag:Fluid ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Liquid ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Makeup ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],

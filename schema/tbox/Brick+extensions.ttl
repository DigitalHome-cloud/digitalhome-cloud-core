            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Mode ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;

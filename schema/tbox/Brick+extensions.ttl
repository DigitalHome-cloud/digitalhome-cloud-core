        [ a sh:TripleRule ;
            sh:object tag:Temporary ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Occupancy,
        tag:Point,
        tag:Status,
        tag:Temporary .

brick:Thermal_Power_Meter a owl:Class,
        sh:NodeShape ;

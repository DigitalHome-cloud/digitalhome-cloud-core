        [ a sh:TripleRule ;
            sh:object tag:Port ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Equipment,
        tag:Ethernet,
        tag:Port .


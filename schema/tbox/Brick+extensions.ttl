            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Valve ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Pressure,
        tag:Relief,
        tag:Steam,
        tag:Valve .


            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Status ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Close,
        tag:Open,
        tag:Point,
        tag:Status .


bsh:AutomationCollectionPointsRequireIsPointOf a sh:NodeShape ;
    sh:property [ sh:message "Points included in an Automation_Collection via rec:includes must have at least one brick:isPointOf relationship" ;
            sh:minCount 1 ;
            sh:path brick:isPointOf ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """
        PREFIX brick: <https://brickschema.org/schema/Brick#>
        PREFIX rec: <https://w3id.org/rec#>
        PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        SELECT DISTINCT ?this
        WHERE {
            ?collection rdf:type/rdfs:subClassOf* brick:Automation_Collection .
            ?collection rec:includes+ ?this .
            ?this rdf:type/rdfs:subClassOf* brick:Point .
        }
        """ ] .


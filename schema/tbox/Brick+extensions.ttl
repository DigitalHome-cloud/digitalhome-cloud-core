        [ a sh:TripleRule ;
            sh:object tag:Zone ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Air,
        tag:Effective,
        tag:Point,
        tag:Setpoint,
        tag:Target,
        tag:Temperature,
        tag:Zone ;
    brick:hasQuantity quantitykind:Temperature .


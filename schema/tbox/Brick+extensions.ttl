bsh:has_exactly_3_tags_condition a owl:Class,
        sh:NodeShape ;
    sh:property [ sh:maxCount 3 ;
            sh:minCount 3 ;
            sh:path brick:hasTag ] .

bsh:has_exactly_5_tags_condition a owl:Class,
        sh:NodeShape ;
    sh:property [ sh:maxCount 5 ;
            sh:minCount 5 ;
            sh:path brick:hasTag ] .

bsh:has_exactly_4_tags_condition a owl:Class,
        sh:NodeShape ;
    sh:property [ sh:maxCount 4 ;
            sh:minCount 4 ;
            sh:path brick:hasTag ] .


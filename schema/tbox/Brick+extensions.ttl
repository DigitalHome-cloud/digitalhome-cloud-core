            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Equipment,
        tag:Hot,
        tag:Meter,
        tag:Water ;

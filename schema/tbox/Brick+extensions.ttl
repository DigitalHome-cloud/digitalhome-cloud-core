brick:Direction_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Direction Sensor"@en ;
    rdfs:subClassOf brick:Sensor ;
    skos:definition "Measures the direction in degrees in which a phenomenon is occuring"@en ;

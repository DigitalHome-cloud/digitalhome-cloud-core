            sh:object tag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Time ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Air,
        tag:Integral,
        tag:PID,
        tag:Parameter,
        tag:Point,
        tag:Temperature,
        tag:Time .


brick:Chilled_Water_Thermal_Expansion_Tank a owl:Class,
        sh:NodeShape ;
    rdfs:label "Chilled Water Thermal Expansion Tank"@en ;
    rdfs:subClassOf brick:Thermal_Expansion_Tank ;

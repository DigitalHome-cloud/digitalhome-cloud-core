rec:Apartment a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Apartment" ;
    rdfs:subClassOf rec:Collection ;
    sh:property [ a sh:PropertyShape ;
            sh:class rec:Room ;
            sh:minCount 1 ;
            sh:name "includes" ;

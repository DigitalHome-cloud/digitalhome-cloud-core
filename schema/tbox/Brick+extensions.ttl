        [ a sh:TripleRule ;
            sh:object tag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Pressure,
        tag:Reducing,
        tag:Valve,
        tag:Water .


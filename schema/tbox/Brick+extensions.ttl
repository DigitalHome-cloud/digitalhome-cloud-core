            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Air,
        tag:Alarm,
        tag:Flow,
        tag:Point .

brick:Air_Flow_Demand_Setpoint a owl:Class,

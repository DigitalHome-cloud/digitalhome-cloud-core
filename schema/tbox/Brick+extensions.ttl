            sh:object tag:Fixed ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Gas ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Liquid ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],

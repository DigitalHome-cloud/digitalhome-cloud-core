            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Switch ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Transfer ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Automatic,
        tag:Equipment,
        tag:Switch,
        tag:Transfer .


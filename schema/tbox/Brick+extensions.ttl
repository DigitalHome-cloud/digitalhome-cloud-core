brick:Hot_Water_Meter a owl:Class,
        sh:NodeShape ;
    rdfs:label "Hot Water Meter"@en ;
    rdfs:subClassOf brick:Water_Meter ;
    skos:definition "A meter that measures the usage or consumption of hot water"@en ;

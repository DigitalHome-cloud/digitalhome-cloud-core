brick:Air_Velocity_Pressure_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Air Velocity Pressure Sensor"@en ;
    qudt:hasQuantityKind quantitykind:DynamicPressure,
        quantitykind:Pressure ;

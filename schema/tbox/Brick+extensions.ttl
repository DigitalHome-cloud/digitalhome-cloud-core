s223:Voltage-6V a s223:Class,
        s223:Voltage-6V,
        sh:NodeShape ;
    rdfs:label "6V"^^xsd:string ;
    s223:hasValue 6.0 ;
    qudt:hasQuantityKind quantitykind:Voltage ;

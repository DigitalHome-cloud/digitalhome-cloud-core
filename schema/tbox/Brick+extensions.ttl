brick:Cooling_Only_Ground_Source_Condensing_Unit a owl:Class,
        sh:NodeShape ;
    rdfs:label "Cooling Only Ground Source Condensing Unit"@en ;
    rdfs:subClassOf brick:Cooling_Only_Condensing_Unit ;
    sh:rule [ a sh:TripleRule ;

    rdfs:subClassOf s223:Numerical-Voltage .

s223:Voltage-5V a s223:Class,
        s223:Voltage-5V,
        sh:NodeShape ;
    rdfs:label "5V"^^xsd:string ;
    s223:hasValue 5.0 ;
    qudt:hasQuantityKind quantitykind:Voltage ;

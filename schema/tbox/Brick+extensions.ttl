        tag:Demand,
        tag:Flow,
        tag:Point,
        tag:Setpoint ;
    brick:hasQuantity quantitykind:VolumeFlowRate ;
    brick:hasSubstance brick:Air .

brick:Air_Temperature_Alarm a owl:Class,
        sh:NodeShape ;

        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "end level" ;
            sh:path rec:endLevel ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "Up" "Down" ) ;
            sh:maxCount 1 ;
            sh:name "trip direction" ;
            sh:path rec:tripDirection ] .


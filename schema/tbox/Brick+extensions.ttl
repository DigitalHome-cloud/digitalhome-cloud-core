            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Setpoint ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Time ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Acceleration,
        tag:Point,
        tag:Setpoint,
        tag:Time ;
    brick:hasQuantity quantitykind:Time .

brick:Active_Chilled_Beam a owl:Class,
        sh:NodeShape ;

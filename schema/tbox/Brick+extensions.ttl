    rdfs:subClassOf brick:Condenser_Heat_Exchanger ;
    skos:definition "A type of heat exchanger used in refrigeration and air conditioning systems where the primary refrigerant vapor condenses into liquid by transferring heat to circulating water. This process typically occurs in a shell-and-tube or plate heat exchanger."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Condenser ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;

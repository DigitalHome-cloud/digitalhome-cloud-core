@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix brick:   <https://brickschema.org/schema/Brick#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dhc:     <https://digitalhome.cloud/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec:     <https://w3id.org/rec#> .
@prefix s223:    <http://data.ashrae.org/standard223#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# DigitalHome.Cloud App Metadata — v3 (UI/UX overlay)
#
# Application-layer annotations consumed by the SmartHome
# Designer (Blockly toolbox) and three.js ontology renderer.
# This file is NOT part of the domain ontology — it skins the
# T-Box for the human user.
#
# Carries:
#   - dhc:designView assignments (toolbox tab placement)
#   - Blockly hints (disposition, field type, parent property)
#   - Localized labels (@de, @fr) for DHC and external classes
#   - Whitelist of Brick / REC / s223 classes exposed in UI
#
# Mirrors the section structure of dhc-core.ttl. Populate via
# py-tools/ontology_explorer.py option [4].
# ============================================================

<https://digitalhome.cloud/ontology/app-metadata>
    a owl:Ontology ;
    rdfs:label "DigitalHome.Cloud App Metadata"@en ;
    dcterms:creator "D-LAB-5 / DigitalHome.Cloud" ;
    dcterms:description "UI/UX overlay for the SmartHome Designer. Annotations on T-Box classes and properties; no domain semantics."@en ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    owl:versionInfo "3.0.0" .

# ────────────────────────────────────────────────────────────
# § Application annotation property definitions
# ────────────────────────────────────────────────────────────

dhc:appMode a owl:AnnotationProperty ;
    rdfs:label "App-Modus"@de,
        "App Mode"@en,
        "Mode d'application"@fr ;
    rdfs:comment """Tailors the application interface:
- private: Simplified UI for homeowners.
- residential-pro: For installers/electricians.
- tertiary: For building managers.
- industrial: For high-power/factory environments."""@en ;
    sh:defaultValue "private" ;
    sh:in ( "private" "residential-pro" "tertiary" "industrial" ) .

dhc:isInstantiated a owl:AnnotationProperty ;
    rdfs:label "Wird instanziiert"@de,
        "Is instantiated"@en,
        "Est instancié"@fr ;
    rdfs:comment "Boolean flag: true if this class is explicitly created as an instance in the A-Box; false if it serves only as an abstract template."@en ;
    rdfs:range xsd:boolean ;
    sh:defaultValue true .

dhc:blocklyBlockTemplate a owl:AnnotationProperty ;
    rdfs:label "Blockly-Block-Vorlage"@de,
        "Blockly Block Template"@en,
        "Modèle de bloc Blockly"@fr ;
    rdfs:comment "Pointer to a block template in dhc-blockly-blockTemplates.json, consumed by the Modeller pipeline. The chosen template is one of the focus class's own ancestors (rdfs:subClassOf*), resolved at prompt time."@en ;
    sh:condition [ sh:property [ sh:hasValue true ;
                    sh:path dhc:isInstantiated ] ] ;
    dhc:choicesFrom "selfAndAncestors" .

dhc:blocklyCategory a owl:AnnotationProperty ;
    rdfs:label "Blockly-Kategorie"@de,
        "Blockly Category"@en,
        "Catégorie Blockly"@fr ;
    rdfs:comment "Optional override for the Blockly toolbox category name. The default, if not defined, is dhc:designView "@en ;
    sh:condition [ sh:property [ sh:hasValue true ;
                    sh:path dhc:isInstantiated ] ] ;
    sh:in ( "governance" "spatial" "building" "electrical" "plumbing" "heating" "network" "automation" "compliance" ) .

dhc:blocklyDisposition a owl:AnnotationProperty ;
    rdfs:label "Blockly-Disposition"@de,
        "Blockly Disposition"@en,
        "Disposition Blockly"@fr ;
    rdfs:comment "How this class appears in the Blockly toolbox: block (draggable), variable (cross-cutting), excluded (hidden)."@en ;
    sh:condition [ sh:property [ sh:hasValue true ;
                    sh:path dhc:isInstantiated ] ] ;
    sh:in ( "block" "variable" "excluded" ) .

dhc:blocklyFieldType a owl:AnnotationProperty ;
    rdfs:label "Blockly-Feldtyp"@de,
        "Blockly Field Type"@en,
        "Type de champ Blockly"@fr ;
    rdfs:comment "Field widget type in Blockly: number, text, dropdown, checkbox."@en ;
    sh:condition [ sh:property [ sh:hasValue true ;
                    sh:path dhc:isInstantiated ] ] ;
    sh:in ( "text" "number" "dropdown" "checkbox" ) .

dhc:choicesFrom a owl:AnnotationProperty ;
    rdfs:label "Auswahl aus"@de,
        "Choices from"@en,
        "Choix à partir de"@fr ;
    rdfs:comment "Dynamic enum source for an annotation property: choices are computed from the focus class's hierarchy at prompt time. Use in place of sh:in when the menu is class-relative (e.g. blocklyBlockTemplate). Allowed values: selfAndAncestors, ancestors, selfAndDescendants, descendants."@en ;
    sh:in ( "selfAndAncestors" "ancestors" "selfAndDescendants" "descendants" ) ;
    dhc:isMetaProperty true .

dhc:defaultValue a owl:AnnotationProperty ;
    rdfs:label "Standardwert"@de,
        "Default Value"@en,
        "Valeur par défaut"@fr ;
    rdfs:comment "Default value for a property in the Designer, consumed by the Modeller pipeline."@en .

dhc:designView a owl:AnnotationProperty ;
    rdfs:label "Entwurfsansicht"@de,
        "Design View"@en,
        "Vue de conception"@fr ;
    rdfs:comment "Assigns a class or property to a toolbox tab in the SmartHome Designer: governance, spatial, building, electrical, plumbing, heating, network, automation, compliance."@en ;
    sh:in ( "governance" "spatial" "building" "electrical" "plumbing" "heating" "network" "automation" "compliance" ) .

dhc:isMetaProperty a owl:AnnotationProperty ;
    rdfs:label "Ist Meta-Eigenschaft"@de,
        "Is meta-property"@en,
        "Est méta-propriété"@fr ;
    rdfs:comment "Marks an annotation property as a configuration knob for other annotation properties. Excluded from the per-class prompt loop in py-tools/ontology_explorer.py."@en ;
    rdfs:range xsd:boolean ;
    sh:defaultValue false ;
    dhc:isMetaProperty true .



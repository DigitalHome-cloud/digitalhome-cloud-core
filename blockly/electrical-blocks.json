      "previousStatement": "sink",
      "nextStatement": "sink",
      "inputsInline": false,
      "colour": "#3b82f6",
      "tooltip": "An electrical socket outlet (dhc:Socket). 'protected by' references the circuit line that feeds it (→ dhc:feedsEquipment). A sink member.",
      "helpUrl": "",
      "data": "dhc:blocklyBlockTemplate=dhc:Socket"
    },

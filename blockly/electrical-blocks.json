      "message0": "⚡ Power Distribution System %1",
      "args0": [
        { "type": "field_input", "name": "name", "text": "Main Installation" }
      ],
      "message1": "neutral system (régime de neutre) %1",
      "args1": [
        {
          "type": "field_dropdown",
          "name": "neutralSystem",
          "options": [
            ["TT", "TT"],
            ["TN-S", "TN-S"],
            ["TN-C", "TN-C"],
            ["IT", "IT"]
          ]
        }
      ],
      "message2": "medium (electrical system) %1",
      "args2": [
        {
          "type": "field_dropdown",
          "name": "hasMedium",
          "options": [
            ["230 V · 1-phase · 50 Hz", "s223:AC-230VLN-1Ph-50Hz"],
            ["400/230 V · 3-phase · 50 Hz", "s223:AC-400VLL-230VLN-3Ph-50Hz"]
          ]
        }
      ],
      "message3": "① source sub-system — energy generators %1",
      "args3": [
        { "type": "input_statement", "name": "sources", "check": "source" }

      "args4": [
        { "type": "input_statement", "name": "routes", "check": "route" }
      ],
      "message5": "③ load sub-system — consumers %1",
      "args5": [
        { "type": "input_statement", "name": "sinks", "check": "sink" }
      ],
      "inputsInline": false,
      "colour": "#3b82f6",
      "tooltip": "Root of an electrical installation (dhc:PowerDistributionSystem ⊑ brick:System). It groups three functional sub-systems — sources, routing, sinks — whose members become brick:hasPart on blockly→abox. neutralSystem is the earthing arrangement (régime de neutre); hasMedium (s223:hasMedium) names the electrical system, e.g. s223:AC-230VLN-1Ph-50Hz.",
      "helpUrl": "",
      "data": "dhc:blocklyBlockTemplate=dhc:PowerDistributionSystem"
    },


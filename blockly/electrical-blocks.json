            ["Washing machine", "WashingMachine"],
            ["Dishwasher", "Dishwasher"],
            ["Oven", "Oven"],
            ["Water heater", "WaterHeater"],
            ["Dryer", "Dryer"],
            ["Other", "Other"]
          ]
        }
      ],
      "message2": "protected by %1",
      "args2": [
        { "type": "field_variable", "name": "FED_BY", "variable": "CB_Circuit", "variableTypes": ["Circuit"], "defaultType": "Circuit" }
      ],
      "previousStatement": "sink",
      "nextStatement": "sink",
      "inputsInline": false,
      "colour": "#3b82f6",
      "tooltip": "A generic consumer appliance (dhc:Appliance — parked; maps to brick:Equipment, with applianceType hinting the specific Brick/223P class). 'protected by' references its circuit line. A sink member.",
      "helpUrl": "",
      "data": "dhc:blocklyBlockTemplate=dhc:Appliance"
    },
    {
      "type": "dhc:SubDistributionBoard",
      "message0": "▥ Sub-Distribution Board %1",
      "args0": [
        { "type": "field_input", "name": "name", "text": "Sub Board" }
      ],
      "message1": "protected by %1",
      "args1": [
        { "type": "field_variable", "name": "FED_BY", "variable": "CB_Circuit", "variableTypes": ["Circuit"], "defaultType": "Circuit" }
      ],
      "mutator": "dhc_board_mutator",
      "previousStatement": "sink",
      "nextStatement": "sink",
      "inputsInline": false,
      "colour": "#3b82f6",
      "tooltip": "A secondary / divisional board fed from a circuit downstream (dhc:SubDistributionBoard). 'protected by' references its feeding circuit line. Use the ⚙ gear to add/remove rows (DIN rails).",
      "helpUrl": "",
      "data": "dhc:blocklyBlockTemplate=dhc:SubDistributionBoard"
    }
  ]

      "inputsInline": false,
      "colour": "#3b82f6",
      "tooltip": "An EV charging station / wallbox (brick:Electric_Vehicle_Charging_Station), an IRVE circuit load. 'protected by' references its circuit line. A sink member.",
      "helpUrl": "",
      "data": "dhc:blocklyBlockTemplate=brick:Electric_Vehicle_Charging_Station"
    },
    {
      "type": "dhc:Appliance",
      "message0": "⊡ Appliance %1",
      "args0": [
        { "type": "field_input", "name": "name", "text": "Appliance" }
      ],
      "message1": "type %1",
      "args1": [
        {
          "type": "field_dropdown",
          "name": "applianceType",
